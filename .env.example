# Dum & Co. — Environment Configuration Template
# Duplicate this file to .env.local and populate with your credentials

# Supabase Credentials (optional for live backend; if omitted, the app runs in full offline mock persistence)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Payment Gateway (Razorpay or Stripe public key)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Google Maps API (optional; defaults to responsive Google Maps embed)
VITE_GOOGLE_MAPS_EMBED_KEY=
